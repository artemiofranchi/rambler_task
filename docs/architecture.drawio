  <diagram id="policy" name="2. Пороги решений">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="policy-0" />
        <mxCell id="policy-1" parent="policy-0" />
        <mxCell id="policy-1" value="Как принимается решение" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1b201e;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="40" y="10" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="policy-2" value="ALLOW" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontFamily=Courier New;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e6b3a;" vertex="1" parent="policy-1">
          <mxGeometry x="40" y="80" width="520" height="56" as="geometry" />
        </mxCell>
        <mxCell id="policy-3" value="REVIEW" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontFamily=Courier New;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#8a5a00;" vertex="1" parent="policy-1">
          <mxGeometry x="560" y="80" width="190" height="56" as="geometry" />
        </mxCell>
        <mxCell id="policy-4" value="BLOCK" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontFamily=Courier New;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#9e2f29;" vertex="1" parent="policy-1">
          <mxGeometry x="750" y="80" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="policy-5" value="&lt;font face=&quot;Courier New&quot;&gt;0&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5d6763;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="30" y="140" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="policy-6" value="&lt;font face=&quot;Courier New&quot;&gt;t_allow&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5d6763;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="530" y="140" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="policy-7" value="&lt;font face=&quot;Courier New&quot;&gt;t_block&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5d6763;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="720" y="140" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="policy-8" value="&lt;font face=&quot;Courier New&quot;&gt;1&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5d6763;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="1070" y="140" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="policy-9" value="P — вероятность нарушения после стекинга. Ширина зон схематичная, реальные пороги — в models/policy.json." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5d6763;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="40" y="170" width="1040" height="30" as="geometry" />
        </mxCell>
        <mxCell id="policy-10" value="&lt;b&gt;t_allow: не пропустить нарушение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;максимальный порог, при котором&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;≥ 95% нарушений получают REVIEW или BLOCK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=12;" vertex="1" parent="policy-1">
          <mxGeometry x="40" y="230" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="policy-11" value="&lt;b&gt;t_block: автоблокировка без ошибок&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;минимальный порог ≥ t_allow, при котором&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;точность BLOCK ≥ 90% → REVIEW минимальный&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=12;" vertex="1" parent="policy-1">
          <mxGeometry x="395" y="230" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="policy-12" value="&lt;b&gt;Цели меняются в конфиге&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;policy.target_recall&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;policy.target_block_precision&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; face=&quot;Courier New&quot; color=&quot;#5d6763&quot;&gt;→ make calibrate, без переобучения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=12;" vertex="1" parent="policy-1">
          <mxGeometry x="760" y="230" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="policy-13" value="Стекинг обучается на части A валидации, пороги подбираются на части B. Тест в подборе не участвует. Тексты со strong-правилом блокируются всегда и в обучение стекинга не входят." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5d6763;fontFamily=Helvetica;" vertex="1" parent="policy-1">
          <mxGeometry x="40" y="350" width="1040" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="offline" name="3. Обучение и оценка">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="offline-0" />
        <mxCell id="offline-1" parent="offline-0" />
        <mxCell id="offline-1" value="Обучение и оценка: make all" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1b201e;fontFamily=Helvetica;" vertex="1" parent="offline-1">
